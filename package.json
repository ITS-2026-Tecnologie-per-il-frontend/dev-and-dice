{
  "name": "dev-and-dice-main",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "test:auth": "node --test tests/auth.mjs",
    "test:play": "node tests/play.mjs",
    "test:rules": "node --experimental-strip-types tests/runtime-database.mjs && node --experimental-strip-types --experimental-specifier-resolution=node tests/verified-database.mjs public/data/rules2014"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "agentation": "^3.1.2",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
